---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Aiden | Hardware & Software Design" bodyClass="home-body">
    <main>
        <!-- =====================================================================
             HERO: TELEMETRÍA DE SISTEMA + COCKPIT
             ===================================================================== -->
        <section class="hero">
            <!-- Tira de telemetría del bus -->
            <div class="telemetry-strip">
                <div class="boot">
                    <span class="led beacon-pulse"></span>
                    <span>&gt; BOOT_SEQ_OK // UTN_FRBA_CORE v4.1 // SYS_CLK: 24.000 MHz // STATUS: READY</span>
                </div>
                <div class="readouts">
                    <span class="v-core">CORE_TEMP: 38.4°C</span>
                    <span class="v-bus">BUS_V: 5.02V</span>
                    <span class="v-tx">TX_RATE: 115200 BAUD</span>
                </div>
            </div>

            <div class="hero-grid">
                <!-- Identidad y bio -->
                <div style="display: flex; flex-direction: column; gap: var(--space-md);">
                    <div class="hero-eyebrow">
                        <span style="font-weight: 700;">&gt;</span>
                        <span>Inicializando sistema...</span>
                        <span class="caret"></span>
                    </div>

                    <h1>Hola, soy <span class="accent">Aiden</span>.</h1>

                    <div style="display: flex; align-items: center; gap: var(--space-sm);">
                        <span class="hash">#</span>
                        <h2>Diseñador de Hardware &amp; Software.</h2>
                    </div>

                    <p class="lede">
                        Estudiante de Ingeniería Electrónica en UTN e instructor de robótica. Especializado en electrónica DIY, diseño de PCBs y sistemas embebidos. Transformo esquemáticos en realidades físicas, desde la mesa de dibujo hasta la línea de ensamblaje.
                    </p>

                    <!-- Barra de specs del hero -->
                    <div class="tag-row" style="margin-top: var(--space-sm);">
                        <span class="tag">[PWR: 3.3V/5V]</span>
                        <span class="tag t-green">[KiCad Pro]</span>
                        <span class="tag t-white">[Firmware C/C++]</span>
                        <span class="tag t-copper">[SMD 0603]</span>
                        <span class="tag">[ESP32 / Arduino]</span>
                    </div>

                    <div class="hero-buttons" style="margin-top: var(--space-lg);">
                        <a href="/archivos/Aiden_CV.pdf" download="Aiden_CV_Hardware_Dev.pdf" class="btn btn-fill">[↓] Descargar CV</a>
                        <a href="/tienda" class="btn">Ir a la Tienda <span style="color: var(--copper-foil);">→</span></a>
                        <a href="/#contacto" class="btn" style="color: var(--copper-foil);">Contactarse</a>
                    </div>
                </div>

                <!-- Bahía de telemetría / osciloscopio -->
                <aside class="scope-panel">
                    <div class="scope-head">
                        <span>&gt;&gt; SCOPE_CH1: PWM_OUT</span>
                        <span class="trigd"><span class="led led-sm beacon-pulse"></span> TRIG'D</span>
                    </div>

                    <div class="scope-screen">
                        <svg viewBox="0 0 320 80" fill="none" preserveAspectRatio="none" aria-hidden="true">
                            <path d="M0,40 L30,40 L30,12 L70,12 L70,68 L110,68 L110,12 L150,12 L150,68 L190,68 L190,12 L230,12 L230,68 L270,68 L270,40 L320,40"
                                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                            <circle class="beacon-pulse" cx="110" cy="12" r="3" fill="currentColor"></circle>
                            <circle class="beacon-pulse" cx="230" cy="68" r="3" fill="currentColor"></circle>
                        </svg>
                    </div>

                    <div class="telemetry-matrix">
                        <div class="telemetry-cell"><span class="k">V_PEAK:</span><span class="v">12.44 V</span></div>
                        <div class="telemetry-cell"><span class="k">FREQ:</span><span class="v cyan">20.0 kHz</span></div>
                        <div class="telemetry-cell"><span class="k">DUTY_CYCLE:</span><span class="v green">72.6 %</span></div>
                        <div class="telemetry-cell"><span class="k">JITTER:</span><span class="v copper">&lt; 14 ns</span></div>
                    </div>

                    <!-- Datasheet: perfil técnico -->
                    <div class="spec-sheet">
                        <div class="spec-sheet-head">
                            <span class="title">Absolute Maximum Ratings</span>
                            <span class="rev">DS_REV: 4.1</span>
                        </div>
                        <div class="scroll">
                            <table class="spec-table">
                                <thead>
                                    <tr>
                                        <th>PARAMETER</th>
                                        <th class="hl">SPECIFICATION</th>
                                        <th>UNIT / NOTES</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="k">DISCIPLINA</td>
                                        <td>Hardware &amp; Embedded / Robótica</td>
                                        <td class="note copper">SYS_CORE</td>
                                    </tr>
                                    <tr>
                                        <td class="k">EDA_SUITE</td>
                                        <td>KiCad</td>
                                        <td class="note">CAD / CAM</td>
                                    </tr>
                                    <tr>
                                        <td class="k">MCU_ARCH</td>
                                        <td>ESP32-S2 / Arduino</td>
                                        <td class="note">XTENSA / AVR</td>
                                    </tr>
                                    <tr>
                                        <td class="k">LANGUAGES</td>
                                        <td>C / C++ (PlatformIO)</td>
                                        <td class="note">NATIVE_LL</td>
                                    </tr>
                                    <tr>
                                        <td class="k">UBICACIÓN</td>
                                        <td>CABA, Argentina (UTN FRBA)</td>
                                        <td class="note">UTC-3</td>
                                    </tr>
                                    <tr>
                                        <td class="k">ESTADO</td>
                                        <td class="ok"><span class="led led-sm beacon-pulse"></span> DISPONIBLE (ACTIVE)</td>
                                        <td class="ok">LOW LATENCY</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="scope-foot">
                        <span>PIN_MODE: PUSH_PULL</span>
                        <span class="mcu">ESP32-S2 MINI</span>
                    </div>
                </aside>
            </div>
        </section>

        <!-- =====================================================================
             01. PORTFOLIO (CARRUSEL INFINITO FLUIDO)
             ===================================================================== -->
        <section id="portfolio" class="band">
            <div class="band-inner">
                <h2 class="section-title"><span>01.</span> Portfolio</h2>
                <div class="carousel-wrapper" style="overflow: hidden; width: 100%; padding: 10px 0;">
                    <button class="carousel-btn btn-prev" aria-label="Anterior" style="left: 0;"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></button>

                    <div class="carousel-track" id="portfolio-track" style="display: flex; gap: var(--space-lg); align-items: stretch;">
                        <div class="card" style="flex: 0 0 320px;">
                            <div class="card-media">
                                <img src="/img/atom-preview.jpg" alt="Robot Sumo Atom">
                                <span class="card-badge"><span class="led led-sm"></span> HARDWARE READY</span>
                            </div>
                            <span class="sys-id">SYS_ID: U01_ROBOT_SUMO</span>
                            <h3>Proyecto AT0M</h3>
                            <p>Diseño integral de robot sumo autónomo de competencia.</p>
                            <div class="tech-stack">
                                <span>Autonomous</span> <span>ESP32-S2</span> <span>Custom PCB</span>
                            </div>
                            <a href="/proyectos/proyecto-atom" class="btn" style="width: 100%; margin-top: auto;">Ver DevBlog</a>
                        </div>
                        <div class="card" style="flex: 0 0 320px;">
                            <div class="card-media">
                                <img src="/img/diseño-robokids-preview.png" alt="Escuela Tekné">
                                <span class="card-badge"><span class="led led-sm"></span> ACTIVE MENTOR</span>
                            </div>
                            <span class="sys-id">SYS_ID: EDU_CURRICULA</span>
                            <h3>Docente de Robótica</h3>
                            <p>Diseño de currícula enfocada en cultura Maker.</p>
                            <div class="tech-stack">
                                <span>Maker Culture</span> <span>Hardware Edu</span> <span>Arduino</span>
                            </div>
                            <a href="/portfolio" class="btn" style="width: 100%; margin-top: auto;">Ver Más</a>
                        </div>
                        <div class="card" style="flex: 0 0 320px;">
                            <div class="card-media">
                                <img src="/img/ftc-preview.jpeg" alt="Mentoreo FTC">
                                <span class="card-badge" style="color: var(--copper-foil); border-color: var(--copper-foil);"><span class="led led-sm led-standby"></span> INTL_QUALIFIED</span>
                            </div>
                            <span class="sys-id">SYS_ID: FTC_COMPETITION</span>
                            <h3>RBK7FTC - Mentoreo</h3>
                            <p>6to puesto y clasificación internacional a México. Optimización técnica para alto rendimiento.</p>
                            <div class="tech-stack">
                                <span>FIRST Tech Challenge</span> <span>Robotics</span> <span>CAD</span>
                            </div>
                            <a href="/proyectos/proyecto-rbk7ftc" class="btn" style="width: 100%; margin-top: auto;">Ver DevBlog</a>
                        </div>
                    </div>

                    <button class="carousel-btn btn-next" aria-label="Siguiente" style="right: 0;"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></button>
                </div>
                <div style="text-align: center; margin-top: var(--space-xl);">
                    <a href="/portfolio" class="btn">[Explorar todo el Portfolio]</a>
                </div>
            </div>
        </section>

        <!-- =====================================================================
             02. STORE (COMING SOON)
             ===================================================================== -->
        <section id="store">
            <h2 class="section-title">
                <span>02.</span> Store
                <span class="tag t-copper" style="margin-left: auto;">HARDWARE_LAB_BATCH_01</span>
            </h2>

            <div class="showcase">
                <div class="showcase-media">
                    <img src="/img/titancore.png" alt="TitanCore 7960">
                    <span class="showcase-flag">COMING SOON</span>
                </div>

                <div style="display: flex; flex-direction: column; gap: var(--space-md);">
                    <div style="display: flex; align-items: center; justify-content: space-between;" class="t-label-micro">
                        <span style="color: var(--silkscreen-subtle);">SKU: TC-7960-PRO</span>
                        <span style="color: var(--status-active); display: inline-flex; align-items: center; gap: var(--space-xxs);">
                            <span class="led led-sm"></span> IN FABRICATION
                        </span>
                    </div>

                    <h3 class="t-headline-lg">TitanCore 7960</h3>

                    <div style="display: flex; align-items: baseline; gap: var(--space-xs);">
                        <span class="price" style="margin: 0;">USD 28.00</span>
                        <span class="t-label-micro" style="color: var(--silkscreen-subtle);">(Precio de referencia)</span>
                    </div>

                    <p class="t-body-lg" style="color: var(--on-surface-variant);">
                        Driver de motores de alto rendimiento optimizado para robótica pesada y de combate. Diseño de PCB en 2 capas, fabricado a pedido.
                    </p>

                    <div class="quick-specs">
                        <div><span class="k">VOLTAGE</span><span class="v">6V - 28V</span></div>
                        <div><span class="k">CURRENT</span><span class="v copper">40A cont.</span></div>
                        <div><span class="k">PEAK</span><span class="v cyan">120A</span></div>
                        <div><span class="k">PROTECTION</span><span class="v ok">Thermal/OCP</span></div>
                    </div>

                    <div class="hero-buttons" style="padding-top: var(--space-sm);">
                        <a href="/productos/producto-driver" class="btn btn-fill">Configurar Encargo</a>
                        <a href="/#contacto" class="btn">Consultar Disponibilidad Batch →</a>
                    </div>
                </div>
            </div>

            <div style="text-align: center; margin-top: var(--space-xl);">
                <a href="/tienda" class="btn">[Ver Catálogo de Hardware]</a>
            </div>
        </section>

        <!-- =====================================================================
             03. OPEN SOURCE
             ===================================================================== -->
        <section id="opensource" class="band">
            <div class="band-inner">
                <h2 class="section-title">
                    <span>03.</span> Open Source
                    <span class="t-label-caps" style="margin-left: auto; color: var(--status-active); display: inline-flex; align-items: center; gap: var(--space-xs);"><span class="material-symbols-outlined" aria-hidden="true">code</span> LICENCIA LIBRE</span>
                </h2>

                <div class="panel" style="display: flex; flex-direction: column; gap: var(--space-md);">
                    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-sm);">
                        <div>
                            <span class="sys-id">&gt; HARDWARE_REPO // REV_1.2</span>
                            <h3 class="t-headline-lg">TitanCore-7960 - Driver de Motores</h3>
                        </div>
                        <div class="tech-stack" style="margin: 0;">
                            <span>KiCad</span> <span>Hardware</span>
                        </div>
                    </div>

                    <p class="t-body-lg" style="color: var(--on-surface-variant); max-width: 48rem;">
                        Diseño de driver open source para robots de combate.
                    </p>

                    <div style="display: flex; flex-wrap: wrap; gap: var(--space-sm);">
                        <a href="https://github.com/Aid-Code" target="_blank" rel="noopener noreferrer" class="btn"><span class="material-symbols-outlined" aria-hidden="true">terminal</span> GitHub</a>
                        <a href="/contribuciones/titancore" class="btn btn-fill"><span class="material-symbols-outlined" aria-hidden="true">menu_book</span> Ver DevBlog</a>
                    </div>
                </div>

                <div style="text-align: center; margin-top: var(--space-xl);">
                    <a href="/contribuciones" class="btn">[Ver Todas las Contribuciones]</a>
                </div>
            </div>
        </section>

        <!-- =====================================================================
             04. CONTACTO
             ===================================================================== -->
        <section id="contacto">
            <h2 class="section-title">
                <span>04.</span> Contacto
                <span class="t-label-micro" style="margin-left: auto; color: var(--silkscreen-subtle);">CHANNEL: DIRECT_IO</span>
            </h2>

            <div class="panel" style="max-width: 48rem; margin: 0 auto; display: flex; flex-direction: column; gap: var(--space-lg);">
                <div style="display: flex; flex-direction: column; gap: var(--space-xs);">
                    <p class="t-body-lg" style="color: var(--silkscreen-bright);">
                        Completá el formulario para consultas sobre desarrollos de hardware, clases o colaboraciones.
                    </p>
                    <span class="t-label-micro" style="color: var(--copper-foil);">&gt; BUFFER_STATUS: AWAITING_INPUT</span>
                </div>

                <form action="https://formspree.io/f/xeaqpnrn" method="POST" style="display: flex; flex-direction: column; gap: var(--space-md);">
                    <!-- El atributo 'name' es vital para que Formspree identifique el dato -->
                    <div class="field">
                        <label for="alias-input"><span class="prompt">&gt;_</span> Nombre / Alias:</label>
                        <input type="text" id="alias-input" name="Nombre" placeholder="p. ej. Ing. Martinez" required>
                    </div>

                    <div class="field">
                        <label for="email-input"><span class="prompt">&gt;_</span> Email:</label>
                        <input type="email" id="email-input" name="Email" placeholder="nombre@laboratorio.com" required>
                    </div>

                    <div class="field">
                        <label for="payload-input"><span class="prompt">&gt;_</span> Mensaje de transmisión...:</label>
                        <textarea id="payload-input" name="Mensaje" rows="5" placeholder="Detalles sobre el esquemático, robot o proyecto pedagógico..." style="resize: vertical;" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-fill" style="width: 100%; padding: var(--space-sm);">[&gt;] Enviar Mensaje</button>
                </form>
            </div>
        </section>

        <!-- =====================================================================
             LINKS & REDES HUB
             ===================================================================== -->
        <section id="links" class="band">
            <div class="band-inner" style="max-width: 56rem; margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; gap: var(--space-md);">
                <div class="t-label-micro" style="display: flex; align-items: center; gap: var(--space-xs); color: var(--primary-container);">
                    <span class="led"></span>
                    <span>NODE_ID: DIRECTORY_HUB</span>
                </div>
                <h2 class="t-headline-lg">Links &amp; Redes</h2>
                <p class="t-body-lg" style="color: var(--on-surface-variant); max-width: 36rem;">
                    Explorá mi contenido, repositorios y redes sociales en un solo lugar.
                </p>
                <a href="/links" class="btn btn-fill" style="padding: var(--space-sm) var(--space-xl);">Ver Links &amp; Redes</a>
            </div>
        </section>
    </main>

    <!-- SCRIPT CARRUSEL Y PARALLAX -->
    <script is:inline>
        // --- 1. PARALLAX ---
        const parallaxBg = document.querySelector('.parallax-bg');
        if (parallaxBg) {
            window.addEventListener('mousemove', (e) => {
                const moveX = (e.clientX / window.innerWidth - 0.5) * -10;
                const moveY = (e.clientY / window.innerHeight - 0.5) * -10;
                parallaxBg.style.transform = `translate(${moveX}px, ${moveY}px)`;
            });
        }

        // --- 2. CARRUSEL MARQUEE INFINITO (CONTINUO Y SUAVE) ---
        const track = document.getElementById('portfolio-track');
        const wrapper = document.querySelector('.carousel-wrapper');
        const btnPrev = document.querySelector('.btn-prev');
        const btnNext = document.querySelector('.btn-next');

        if (track && wrapper) {
            const originalCards = Array.from(track.children);
            const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;

            let uniqueWidth = 0;

            function ensureEnoughClones() {
                track.querySelectorAll('[data-clone="true"]').forEach(el => el.remove());

                uniqueWidth = originalCards.reduce((acc, el) => acc + el.getBoundingClientRect().width + gap, 0);
                const wrapperWidth = wrapper.getBoundingClientRect().width;
                const copiesNeeded = Math.max(1, Math.ceil((wrapperWidth * 2) / uniqueWidth));

                for (let i = 0; i < copiesNeeded; i++) {
                    originalCards.forEach(card => {
                        const clone = card.cloneNode(true);
                        clone.setAttribute('data-clone', 'true');
                        clone.setAttribute('aria-hidden', 'true');
                        clone.querySelectorAll('a').forEach(a => a.setAttribute('tabindex', '-1'));
                        track.appendChild(clone);
                    });
                }
            }

            // Espera a que las imágenes tengan tamaño antes de medir
            window.addEventListener('load', ensureEnoughClones);
            ensureEnoughClones();

            let offset = 0;
            let target = null;
            let paused = false;
            const AUTO_SPEED = 0.6;

            function frame() {
                if (target !== null) {
                    const diff = target - offset;
                    if (Math.abs(diff) < 0.5) {
                        offset = target;
                        target = null;
                    } else {
                        offset += diff * 0.12;
                    }
                } else if (!paused) {
                    offset -= AUTO_SPEED;
                }

                // Wrap infinito: si el offset se resetea, el target tiene que corregirse igual
                if (uniqueWidth > 0) {
                    while (offset <= -uniqueWidth) {
                        offset += uniqueWidth;
                        if (target !== null) target += uniqueWidth;
                    }
                    while (offset > 0) {
                        offset -= uniqueWidth;
                        if (target !== null) target -= uniqueWidth;
                    }
                }

                track.style.transform = `translateX(${offset}px)`;
                requestAnimationFrame(frame);
            }
            requestAnimationFrame(frame);

            wrapper.addEventListener('mouseenter', () => paused = true);
            wrapper.addEventListener('mouseleave', () => paused = false);

            function stepWidth() {
                return originalCards[0].getBoundingClientRect().width + gap;
            }

            if (btnNext) btnNext.addEventListener('click', () => {
                const base = target !== null ? target : offset;
                target = base - stepWidth();
            });

            if (btnPrev) btnPrev.addEventListener('click', () => {
                const base = target !== null ? target : offset;
                target = base + stepWidth();
            });

            let resizeTimeout;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(ensureEnoughClones, 200);
            });
        }
    </script>
</Layout>