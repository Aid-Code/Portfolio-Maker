---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Open Source | Aiden">
    <main style="padding-top: 120px;">
        <section>
            <h1 class="section-title"><span>&gt;</span> Open Source</h1>
            <div class="grid">
                <div class="card">
                    <h3>Driver de Motores Libre</h3>
                    <p>Diseño esquemático y PCB de un driver open source para la comunidad.</p>
                    <div style="display: flex; gap: 10px; margin-top: auto;">
                        <a href="https://github.com/Aid-Code" target="_blank" class="btn" style="flex:1;">GitHub</a>
                        <a href="/contribuciones/titancore" class="btn btn-fill" style="flex:1;">Ver Blog</a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>